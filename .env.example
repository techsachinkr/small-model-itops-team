# Optional settings. Nothing in the repo reads .env by itself: copy this file to .env, then load it into your shell
# with `set -a; source .env; set +a` before running a command. No API keys are needed: every model runs locally on vLLM.

# Model calls outside NeMo Gym (common/llm.py): live (the default), record (also save every response to runs/cache/),
# or replay (answer from runs/cache/ with no server; for building and as a demo fallback, never for evals).
LLM_MODE=live

# Keeps one scenario's recordings apart from another's. The demo page sets it for each take itself.
# LLM_CACHE_TAG=

# Where Hugging Face downloads go (the default is ~/.cache/huggingface), and a token if your account needs one.
# HF_HOME=
# HF_TOKEN=
