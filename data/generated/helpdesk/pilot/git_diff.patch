diff --git a/eval/decontaminate.py b/eval/decontaminate.py
index ad35500..5389d85 100644
--- a/eval/decontaminate.py
+++ b/eval/decontaminate.py
@@ -1 +1,140 @@
-"""Drops generated tasks that are too similar to practice cases, or to test cases at the final run."""
+"""Drops generated tasks that are too similar to the practice cases.
+
+    uv run python -m eval.decontaminate --tasks data/generated/helpdesk/pilot/tasks_pilot.jsonl --against practice
+
+A task is dropped for the first of these that applies (thresholds in configs/factory.yaml):
+- text: its request scores at least `text_threshold` against a practice request. The score is the larger
+  of two cosine similarities on lowercased text: of word 1- and 2-gram counts, and of character 4-gram
+  counts (which catches rewordings like "crashes"/"crashing").
+- same_user: it changes nothing (missing_info, no_tool, read_only) and scores at least `same_user_threshold`
+  against a practice case of the same kind from the same user on the same fixture: the same situation,
+  which the changes check can't see.
+- changes: its state-changing gold calls are the same as a practice case's, or a part of them, leaving out
+  free text (summaries, notes) and the change ticket. Training on that would teach that case's answer.
+Text alone can't tell a paraphrase from a different request built on the same template, so its threshold is
+high, and the other two catch what it misses.
+
+Only `--against practice` exists for now (task 2.1). Hard rule 4 lets this script read data/test/ only when
+a human asks for that run, so that option needs adding first.
+
+Rewrites --tasks with the kept tasks (the file's line order is kept), and writes
+<tasks stem>.decontaminate.json next to it: the settings, the practice cases compared, the score
+distribution, and every dropped task with its reason, nearest practice case and score.
+"""
+
+import argparse
+import json
+import math
+import re
+from collections import Counter
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+from common.schemas import Case
+from eval.run_eval import REPO
+from factory.sampler import FACTORY_CONFIG, load_factory_config
+from gym_env.tasks import read_cases
+
+CHANGING_TOOLS = {"create_ticket", "update_ticket", "reset_password", "rollback", "scale"}
+IGNORED_ARGS = {"summary", "note", "change_ticket"}  # free text, and a ticket the request just names
+TEST_DIR = REPO / "data" / "test"
+
+
+def words(text: str) -> list[str]:
+    return re.findall(r"[a-z0-9]+(?:[.-][a-z0-9]+)*", text.casefold())
+
+
+def features(text: str) -> tuple[Counter[str], Counter[str]]:
+    tokens = words(text)
+    grams = Counter(tokens) + Counter(" ".join(pair) for pair in zip(tokens, tokens[1:]))
+    squeezed = " ".join(tokens)
+    chars = Counter(squeezed[i:i + 4] for i in range(len(squeezed) - 3))
+    return grams, chars
+
+
+def cosine(a: Counter[str], b: Counter[str]) -> float:
+    dot = sum(count * b[key] for key, count in a.items())
+    norm = math.sqrt(sum(v * v for v in a.values()) * sum(v * v for v in b.values()))
+    return dot / norm if norm else 0.0
+
+
+def similarity(a: str, b: str) -> float:
+    (grams_a, chars_a), (grams_b, chars_b) = features(a), features(b)
+    return max(cosine(grams_a, grams_b), cosine(chars_a, chars_b))
+
+
+def changes(case: Case) -> Counter[str]:
+    """The case's state-changing calls without IGNORED_ARGS, as a multiset."""
+    return Counter(
+        json.dumps({"tool": call.tool, "args": {k: v for k, v in call.args.items() if k not in IGNORED_ARGS}}, sort_keys=True)
+        for call in case.gold_calls if call.tool in CHANGING_TOOLS
+    )
+
+
+def verdict(task: Case, references: list[Case], thresholds: dict[str, float]) -> dict[str, Any]:
+    """The nearest reference by text, and why the task is dropped (reason None if it's kept)."""
+    scored = [(similarity(task.request, ref.request), ref) for ref in references]
+    score, nearest = max(scored, key=lambda pair: pair[0])
+    situation = (task.kind, task.user_id, task.fixture)
+    same_user = max((s for s, ref in scored if (ref.kind, ref.user_id, ref.fixture) == situation
+                     and task.kind not in ("single", "multi")), default=0.0)
+    task_changes = changes(task)
+    same = [ref.id for ref in references if task_changes and not task_changes - changes(ref)]
+    if score >= thresholds["text_threshold"]:
+        reason = "text"
+    elif same_user >= thresholds["same_user_threshold"]:
+        reason = "same_user"
+    else:
+        reason = "changes" if same else None
+    return {"id": task.id, "reason": reason, "score": round(score, 3), "nearest": nearest.id,
+            "same_user_score": round(same_user, 3), "same_changes_as": same}
+
+
+def practice_cases() -> list[Case]:
+    return [case for path in sorted((REPO / "data" / "practice").glob("*.jsonl")) for case in read_cases(path)]
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Drop generated tasks too similar to the practice cases.")
+    parser.add_argument("--tasks", type=Path, required=True, help="a tasks_<name>.jsonl file; rewritten in place")
+    parser.add_argument("--against", required=True, choices=["practice"], help="practice only for now (hard rule 4)")
+    parser.add_argument("--config", type=Path, default=FACTORY_CONFIG)
+    args = parser.parse_args()
+    if args.tasks.resolve().is_relative_to(TEST_DIR):
+        raise SystemExit("data/test/ is locked (hard rule 4).")
+    report_path = args.tasks.with_name(args.tasks.stem + ".decontaminate.json")
+    if report_path.exists():
+        raise SystemExit(f"{report_path} exists: these tasks were already decontaminated.")
+    thresholds = load_factory_config(args.config)["decontaminate"]
+
+    references = practice_cases()
+    tasks = read_cases(args.tasks)
+    verdicts = [verdict(task, references, thresholds) for task in tasks]
+    kept = [task for task, v in zip(tasks, verdicts) if v["reason"] is None]
+    dropped = [{**v, "task": task.model_dump(mode="json", exclude_none=True)}
+               for task, v in zip(tasks, verdicts) if v["reason"] is not None]
+    scores = sorted(v["score"] for v in verdicts)
+    report_path.write_text(json.dumps({
+        "script": "eval/decontaminate.py",
+        "created_at": datetime.now(timezone.utc).isoformat(),
+        "against": args.against,
+        "thresholds": thresholds,
+        "references": [case.id for case in references],
+        "tasks": len(tasks),
+        "kept": len(kept),
+        "dropped_by_reason": dict(Counter(d["reason"] for d in dropped)),
+        "score_quantiles": {q: scores[min(len(scores) - 1, int(q * len(scores)))] for q in (0.5, 0.9, 0.99)} if scores else {},
+        "dropped": dropped,
+    }, indent=1))
+    args.tasks.write_text("".join(task.model_dump_json(exclude_none=True) + "\n" for task in kept))
+
+    print(f"{args.tasks}: kept {len(kept)}/{len(tasks)} against {len(references)} practice cases ({thresholds})")
+    for d in dropped:
+        print(f"  dropped {d['id']} ({d['reason']}): score {d['score']} vs {d['nearest']}, same user "
+              f"{d['same_user_score']}, same changes as {d['same_changes_as']}")
+    print(f"Report in {report_path}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/factory/collect.py b/factory/collect.py
index f7b461b..103b642 100644
--- a/factory/collect.py
+++ b/factory/collect.py
@@ -1 +1,110 @@
-"""Collects Lightning rollouts on generated tasks through NeMo Gym."""
+"""Collects Lightning rollouts on generated tasks through NeMo Gym.
+
+    uv run python -m factory.collect --tasks data/generated/helpdesk/pilot/tasks_pilot.jsonl --run-id pilot_helpdesk
+
+Lightning's vLLM server must be running (scripts/serve_lightning.sh) and port 11000 free. Like
+eval/run_eval.py, this starts the Gym servers for the `lightning` setup (gym_configs/lightning.yaml: the
+itops agent with the seatbelt), collects the rollouts with `gym eval run`, and stops the servers. The
+agent's settings are configs/eval.yaml with the `collect` fields of configs/factory.yaml changed
+(thinking on, one attempt per task), so the tools, seatbelt and max steps are the eval's. This isn't an
+eval: factory/filter.py turns the rollouts into training data.
+
+Writes to runs/<run_id>/:
+    config.json         arguments, the factory config, the resolved agent config, the task files, the git commit
+    git_diff.patch      uncommitted changes, when the tree is dirty
+    agent_config.yaml   the agent's settings (configs/eval.yaml + the collect fields)
+    tasks.jsonl         the Gym rows (gym_env/tasks.py)
+    rollouts.jsonl      Gym's rollouts, next to Gym's side files, gym_env.log and gym_eval.log
+Refuses tasks under data/test/ (hard rule 5: the factory never sees test data) and runs with chaos on.
+"""
+
+import argparse
+import json
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+import yaml
+
+from common.eval_config import EVAL_CONFIG, EvalConfig
+from eval.run_eval import REPO, collect, git_commit, server_chaos_enabled, start_servers, stop_servers
+from factory.sampler import FACTORY_CONFIG, load_factory_config
+from gym_env.tasks import case_to_row, read_cases
+
+SETUP = "lightning"
+TEST_DIR = REPO / "data" / "test"
+
+
+def agent_config(factory_config: dict[str, Any], eval_path: Path = EVAL_CONFIG) -> dict[str, Any]:
+    """configs/eval.yaml with the factory's collect fields changed, validated as an EvalConfig."""
+    settings = yaml.safe_load(eval_path.read_text()) | factory_config["collect"]
+    EvalConfig.model_validate(settings)
+    return settings
+
+
+def refusal(tasks: Path, settings: dict[str, Any], server_chaos: bool) -> str | None:
+    if tasks.resolve().is_relative_to(TEST_DIR):
+        return "data/test/ is locked (hard rules 4 and 5): the factory never sees test data."
+    if settings["chaos"] or server_chaos:
+        return "chaos is on; rollouts for training are collected without it."
+    return None
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Collect Lightning rollouts on generated tasks through NeMo Gym.")
+    parser.add_argument("--tasks", type=Path, required=True, help="a tasks_<name>.jsonl file from factory/writer.py")
+    parser.add_argument("--run-id", help="default: <time>_collect_<tasks name>")
+    parser.add_argument("--config", type=Path, default=FACTORY_CONFIG, help="factory config")
+    args = parser.parse_args()
+
+    factory_config = load_factory_config(args.config)
+    settings = agent_config(factory_config)
+    if reason := refusal(args.tasks, settings, server_chaos_enabled()):
+        raise SystemExit(f"Refusing to run: {reason}")
+    cases = read_cases(args.tasks)
+    if not cases:
+        raise SystemExit(f"No tasks in {args.tasks}.")
+
+    started = datetime.now(timezone.utc)
+    run_id = args.run_id or f"{started:%Y%m%d-%H%M%S}_collect_{args.tasks.stem.removeprefix('tasks_')}"
+    run_dir = REPO / "runs" / run_id
+    run_dir.mkdir(parents=True, exist_ok=False)
+    agent_path = run_dir / "agent_config.yaml"
+    agent_path.write_text(yaml.safe_dump(settings, sort_keys=False))
+    tasks_path = args.tasks.resolve()
+    (run_dir / "config.json").write_text(json.dumps({
+        "run_id": run_id,
+        "script": "factory/collect.py",
+        "args": {key: str(value) if isinstance(value, Path) else value for key, value in vars(args).items()},
+        "started_at": started.isoformat(),
+        "setup": SETUP,
+        "tasks": str(tasks_path.relative_to(REPO)) if tasks_path.is_relative_to(REPO) else str(tasks_path),
+        "task_count": len(cases),
+        "factory_config": factory_config,
+        "agent_config": settings,
+        **git_commit(run_dir),
+    }, indent=2))
+    rows = run_dir / "tasks.jsonl"
+    rows.write_text("".join(json.dumps(case_to_row(case)) + "\n" for case in cases))
+
+    attempts = settings["attempts_per_case"]
+    print(f"{run_id}: {len(cases)} tasks x {attempts} attempt(s) with {SETUP}; starting Gym servers")
+    servers = start_servers(SETUP, agent_path, False, run_dir / "gym_env.log")
+    try:
+        returncode = collect(rows, run_dir / "rollouts.jsonl", attempts, run_dir / "gym_eval.log")
+    finally:
+        stop_servers(servers)
+
+    rollouts = run_dir / "rollouts.jsonl"
+    collected = [json.loads(line) for line in rollouts.read_text().splitlines() if line.strip()] if rollouts.exists() else []
+    expected = len(cases) * attempts
+    passed = sum(row.get("reward") == 1.0 for row in collected)
+    print(f"Collected {len(collected)}/{expected} rollouts; reward 1 on {passed}/{len(collected)} "
+          "(before the filter's no-failed-calls check)")
+    if returncode != 0 or len(collected) != expected:
+        print(f"PARTIAL RUN: gym eval run exited {returncode}. See {run_dir / 'gym_eval.log'}.")
+    print(f"Results in {run_dir}\nNext: python -m factory.filter --run {run_id} ...")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/factory/filter.py b/factory/filter.py
index 12cd6b4..c07d967 100644
--- a/factory/filter.py
+++ b/factory/filter.py
@@ -1 +1,249 @@
-"""Keeps rollouts the verifier passes with no failed calls, rendered with the student's chat template."""
+"""Keeps rollouts the verifier passes with no failed calls, rendered with the student's chat template.
+
+    uv run --group train python -m factory.filter --run pilot_helpdesk --round 1 \\
+        --output data/generated/helpdesk/pilot/round_1.jsonl --show 5
+
+Reads runs/<run_id>/ from factory/collect.py: rollouts.jsonl, and through config.json the task file with
+its .config.json (each task's origin; slots the writer dropped) and .decontaminate.json (tasks dropped
+before collection). A rollout is kept only if its `reward` is 1 (the verifier's state match and answer
+checks passed, and the seatbelt didn't give up), every call returned 200, and the self-check never sent
+Lightning back to work (that nudge is a user turn the student shouldn't learn to wait for). Otherwise
+its reason is the first of: gave_up, state_mismatch, answer_mismatch, failed_call (status 0 is a call
+the seatbelt blocked), self_check_nudge, other. A task with no rollout is `no_rollout`.
+
+Each kept rollout becomes a TrainingExample (common/schemas.py):
+- messages: Lightning's whole conversation in chat format, with its reasoning in `reasoning_content`.
+- text: the same conversation rendered as the student is evaluated: the student base model's chat
+  template (configs/models.yaml, pinned revision) with enable_thinking=False, the reasoning dropped,
+  tool-call arguments as objects and the rollout's own tool definitions, as vLLM passes them. In the
+  assistant's text, look-alike hyphens and spaces become ASCII: Lightning writes IDs like "HD‑1041" with
+  a non-breaking hyphen (82 of its 199 answers in the task 1.2 runs), which the student would learn and
+  the verifier's answer checks would then miss.
+
+Writes --output, <output stem>.stats.json next to it (counts by origin and reason, by kind and template),
+and runs/<run_id>/filter_rejected.jsonl (each rejected rollout's task, reason and trace).
+"""
+
+import argparse
+import json
+import os
+import random
+import re
+from collections import Counter, defaultdict
+from functools import cache
+from pathlib import Path
+from typing import Any
+
+import yaml
+
+from common.llm import MODELS_CONFIG
+from common.schemas import Case, TrainingExample
+from eval.run_eval import REPO
+from gym_env.tasks import read_cases
+
+# Importing nemo_gym sets HF_HOME to Gym's own cache folder unless it is already set. Keep the usual
+# Hugging Face cache, where the student's tokenizer is (nemo_gym is imported only in conversation()).
+os.environ.setdefault("HF_HOME", str(Path.home() / ".cache" / "huggingface"))
+
+THINK_BLOCK = re.compile(r"<think>(.*?)</think>", re.DOTALL)
+REASONS = ("gave_up", "state_mismatch", "answer_mismatch", "failed_call", "self_check_nudge", "other")
+
+
+def rejection(row: dict[str, Any]) -> str | None:
+    """Why a rollout can't be training data (None if it can)."""
+    step = row["trace"]["steps"][0]
+    events = step["seatbelt_events"]
+    if any(event["kind"] == "gave_up" for event in events):
+        return "gave_up"
+    if not row.get("state_match"):
+        return "state_mismatch"
+    if not row.get("answer_ok"):
+        return "answer_mismatch"
+    if any(call["status"] != 200 for call in step["calls"]):
+        return "failed_call"
+    if any(event["kind"] == "self_check" and event.get("complete") is False for event in events):
+        return "self_check_nudge"
+    return None if row.get("reward") == 1.0 else "other"
+
+
+def conversation(row: dict[str, Any]) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
+    """The rollout's input and output as chat messages (reasoning in reasoning_content), and its tools."""
+    from nemo_gym.openai_utils import NeMoGymResponseCreateParamsNonStreaming
+    from nemo_gym.responses_converter import ResponsesConverter
+
+    params = dict(row["responses_create_params"])
+    params["input"] = [*params["input"], *row["response"]["output"]]
+    converter = ResponsesConverter(return_token_id_information=False, uses_reasoning_parser=True)
+    chat = converter.responses_to_chat_completion_create_params(NeMoGymResponseCreateParamsNonStreaming.model_validate(params))
+    messages = []
+    for message in chat.messages:
+        message = dict(message)
+        if message["role"] == "assistant":
+            content = message.get("content") or ""
+            thoughts = [t.strip() for t in THINK_BLOCK.findall(content)]
+            message["content"] = THINK_BLOCK.sub("", content).strip()
+            if any(thoughts):
+                message["reasoning_content"] = "\n\n".join(t for t in thoughts if t)
+        messages.append(message)
+    return messages, [dict(tool) for tool in chat.tools or []]
+
+
+ASCII_LOOKALIKES = str.maketrans({"\u2010": "-", "\u2011": "-", "\u2012": "-", "\u00a0": " ", "\u202f": " "})
+
+
+def for_template(messages: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    """Messages as the student sees them: no reasoning, ASCII hyphens and spaces in the assistant's text,
+    tool-call arguments as objects (as vLLM passes them)."""
+    plain = []
+    for message in messages:
+        message = {key: value for key, value in message.items() if key != "reasoning_content"}
+        if message["role"] == "assistant" and isinstance(message.get("content"), str):
+            message["content"] = message["content"].translate(ASCII_LOOKALIKES)
+        if message.get("tool_calls"):
+            message["tool_calls"] = [
+                {**call, "function": {**call["function"], "arguments": json.loads(call["function"]["arguments"] or "{}")}}
+                for call in message["tool_calls"]
+            ]
+        plain.append(message)
+    return plain
+
+
+@cache
+def student_tokenizer() -> Any:
+    from transformers import AutoTokenizer
+
+    student = yaml.safe_load(MODELS_CONFIG.read_text())["models"]["student"]
+    return AutoTokenizer.from_pretrained(student["hf_id"], revision=student["revision"])
+
+
+def render(messages: list[dict[str, Any]], tools: list[dict[str, Any]]) -> str:
+    text = student_tokenizer().apply_chat_template(for_template(messages), tools=tools, tokenize=False, enable_thinking=False)
+    if re.search(r"<think>(?!</think>)", text):
+        raise ValueError("reasoning left in the rendered text")
+    return text
+
+
+def teacher() -> str:
+    lightning = yaml.safe_load(MODELS_CONFIG.read_text())["models"]["lightning"]
+    return f"{lightning['hf_id']}@{lightning['revision']}"
+
+
+def sidecar(tasks_path: Path, suffix: str) -> dict[str, Any]:
+    path = tasks_path.with_name(tasks_path.stem + suffix)
+    return json.loads(path.read_text()) if path.exists() else {}
+
+
+def task_info(case_id: str, writer_config: dict[str, Any]) -> dict[str, Any]:
+    info = writer_config.get("tasks", {}).get(case_id)
+    if info is None:
+        raise SystemExit(f"{case_id} isn't in the writer's config file, so its origin is unknown.")
+    return info
+
+
+def template_of(info: dict[str, Any]) -> str:
+    return info.get("template") or f"written:{info.get('focus')}"
+
+
+def stats(outcomes: list[dict[str, Any]], writer_config: dict[str, Any], decontamination: dict[str, Any]) -> dict[str, Any]:
+    """Counts by origin of every slot: dropped by the writer, decontaminated, kept or rejected (with the reason)."""
+    table: dict[str, Counter[str]] = defaultdict(Counter)
+    for dropped in writer_config.get("dropped", []):
+        table[dropped["origin"]]["writer_dropped"] += 1
+    for dropped in decontamination.get("dropped", []):
+        info = writer_config.get("tasks", {}).get(dropped["id"], {})
+        table[info.get("origin", "unknown")][f"decontaminated_{dropped['reason']}"] += 1
+    by_kind: dict[str, Counter[str]] = defaultdict(Counter)
+    by_template: dict[str, Counter[str]] = defaultdict(Counter)
+    for outcome in outcomes:
+        result = outcome["reason"] or "kept"
+        table[outcome["origin"]][result] += 1
+        by_kind[outcome["kind"]][result] += 1
+        by_template[outcome["template"]][result] += 1
+    totals: Counter[str] = sum(table.values(), Counter())
+    return {"by_origin": {origin: dict(counts) for origin, counts in sorted(table.items())}, "total": dict(totals),
+            "by_kind": {k: dict(v) for k, v in sorted(by_kind.items())},
+            "by_template": {k: dict(v) for k, v in sorted(by_template.items())}}
+
+
+def show(example: TrainingExample, case: Case, info: dict[str, Any]) -> str:
+    lines = [f"=== {example.id} ({example.origin}, {example.kind}, {template_of(info)}; user {case.user_id}, {case.fixture})",
+             f"USER: {case.request}"]
+    for message in example.messages[2:]:
+        if message["role"] == "assistant":
+            for call in message.get("tool_calls") or []:
+                lines.append(f"  CALL {call['function']['name']}({call['function']['arguments']})")
+            if message.get("content"):
+                lines.append(f"ASSISTANT: {message['content']}")
+        elif message["role"] == "tool":
+            output = message["content"]
+            lines.append(f"  -> {output if len(output) <= 200 else output[:200] + '...'}")
+    lines.append("  gold: " + (", ".join(f"{c.tool}({json.dumps(c.args)})" for c in case.gold_calls) or "no calls"))
+    return "\n".join(lines)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Turn verified Lightning rollouts into training examples.")
+    parser.add_argument("--run", required=True, help="a run id from factory/collect.py")
+    parser.add_argument("--round", type=int, required=True)
+    parser.add_argument("--output", type=Path, required=True, help="e.g. data/generated/<api>/round_<n>.jsonl")
+    parser.add_argument("--show", type=int, default=0, help="print this many kept examples (seeded choice)")
+    args = parser.parse_args()
+
+    run_dir = REPO / "runs" / args.run
+    collect_config = json.loads((run_dir / "config.json").read_text())
+    tasks_path = REPO / collect_config["tasks"]
+    cases = {case.id: case for case in read_cases(tasks_path)}
+    writer_config = sidecar(tasks_path, ".config.json")
+    decontamination = sidecar(tasks_path, ".decontaminate.json")
+    rollouts_path = run_dir / "rollouts.jsonl"
+    rows = [json.loads(line) for line in rollouts_path.read_text().splitlines() if line.strip()] if rollouts_path.exists() else []
+    if args.output.exists():
+        raise SystemExit(f"{args.output} exists; remove it or pick another --output.")
+
+    rows_by_case: dict[str, list[dict[str, Any]]] = defaultdict(list)
+    for row in rows:
+        rows_by_case[row["task_id"]].append(row)
+    outcomes, examples, rejected = [], [], []
+    for case_id, case in cases.items():
+        info = task_info(case_id, writer_config)
+        base = {"case_id": case_id, "origin": info["origin"], "kind": case.kind, "template": template_of(info)}
+        if not rows_by_case.get(case_id):
+            outcomes.append({**base, "reason": "no_rollout"})
+            continue
+        for row in sorted(rows_by_case[case_id], key=lambda r: r["_ng_rollout_index"]):
+            reason = rejection(row)
+            outcomes.append({**base, "reason": reason})
+            if reason is not None:
+                rejected.append({**base, "reason": reason, "attempt": row["_ng_rollout_index"] + 1,
+                                 "state_diff": row.get("state_diff"), "missing_from_answer": row.get("missing_from_answer"),
+                                 "forbidden_in_answer": row.get("forbidden_in_answer"), "trace": row["trace"]})
+                continue
+            messages, tools = conversation(row)
+            examples.append(TrainingExample(
+                id=f"{case_id}-{row['_ng_rollout_index'] + 1}", api=case.apis[0], round=args.round, kind=case.kind,
+                origin=info["origin"], source="broad", case_id=case_id, teacher=teacher(), reward=row["reward"],
+                messages=messages, text=render(messages, tools)))
+
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text("".join(example.model_dump_json(exclude_none=True) + "\n" for example in examples))
+    (run_dir / "filter_rejected.jsonl").write_text("".join(json.dumps(r) + "\n" for r in rejected))
+    summary = stats(outcomes, writer_config, decontamination)
+    stats_path = args.output.with_name(args.output.stem + ".stats.json")
+    stats_path.write_text(json.dumps({"run": args.run, "tasks": collect_config["tasks"], "round": args.round,
+                                      "rollouts": len(rows), "kept": len(examples), **summary}, indent=1))
+
+    columns = ["writer_dropped", *sorted({k for c in summary["by_origin"].values() for k in c if k.startswith("decontaminated")}),
+               "no_rollout", *REASONS, "kept"]
+    columns = [c for c in columns if summary["total"].get(c)]
+    print(f"{args.run}: {len(examples)} kept from {len(rows)} rollouts on {len(cases)} tasks")
+    print(f"{'origin':<10}" + "".join(f"{c:>{max(len(c), 5) + 2}}" for c in columns))
+    for origin, counts in [*summary["by_origin"].items(), ("total", summary["total"])]:
+        print(f"{origin:<10}" + "".join(f"{counts.get(c, 0):>{max(len(c), 5) + 2}}" for c in columns))
+    print("by kind: " + "; ".join(f"{kind} {c.get('kept', 0)}/{sum(c.values())} kept" for kind, c in summary["by_kind"].items()))
+    print(f"Examples in {args.output}\nStats in {stats_path}\nRejected rollouts in {run_dir / 'filter_rejected.jsonl'}")
+    for example in random.Random(0).sample(examples, min(args.show, len(examples))):
+        print("\n" + show(example, cases[example.case_id], task_info(example.case_id, writer_config)))
+
+
+if __name__ == "__main__":
+    main()
